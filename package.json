{
  "name": "pax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "setup": "pnpm install && pnpm run prepare",
    "prepare": "husky",
    "dev": "next dev",
    "dev:docker": "bash scripts/dev-local.sh",
    "dev:docker:logs": "bash scripts/dev-local.sh logs",
    "dev:docker:down": "bash scripts/dev-local.sh stop",
    "dev:docker:restart": "bash scripts/dev-local.sh restart",
    "dev:docker:status": "bash scripts/dev-local.sh status",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "test:db": "vitest run --config vitest.database.config.ts",
    "test:browser": "playwright test",
    "ai:evaluate": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-ai.ts",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "typecheck": "tsc --noEmit",
    "dev:workers": "vinext dev",
    "build:workers": "vinext build",
    "deploy:workers": "vinext deploy",
    "deploy:workers:preview": "vinext deploy --preview",
    "lint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint",
    "format": "prettier --check README.md CONTRIBUTING.md dangerfile.ts typedoc.json .changeset/config.json .devcontainer/devcontainer.json docker-compose.yml docker-compose.local.yml \".github/**/*.{yml,md}\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" src/app/api/assistant/chat/route.ts src/app/api/health/route.ts src/app/api/metrics/route.ts src/app/layout.tsx src/lib/feature-flags.ts src/lib/knowledge.ts src/lib/logger.ts src/lib/metrics.ts src/lib/request-context.ts src/proxy.ts",
    "format:write": "prettier --write README.md CONTRIBUTING.md dangerfile.ts typedoc.json .changeset/config.json .devcontainer/devcontainer.json docker-compose.yml docker-compose.local.yml \".github/**/*.{yml,md}\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" src/app/api/assistant/chat/route.ts src/app/api/health/route.ts src/app/api/metrics/route.ts src/app/layout.tsx src/lib/feature-flags.ts src/lib/knowledge.ts src/lib/logger.ts src/lib/metrics.ts src/lib/request-context.ts src/proxy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "lint:todo": "node scripts/check-todos.mjs src tests docs .github .devcontainer",
    "lint:large-files": "node scripts/check-large-files.mjs",
    "lint:duplicates": "jscpd --config .jscpd.json",
    "knip": "knip --dependencies --exclude exports,types,binaries --no-config-hints",
    "docs:generate": "typedoc",
    "changeset": "changeset",
    "release:version": "changeset version",
    "danger:ci": "danger ci",
    "analyze:bundle": "ANALYZE=true next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "knowledge:sync:irs": "node scripts/sync-irs-guidance.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "1.5.5",
    "ai": "^7.0.88",
    "better-auth": "1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.2",
    "next": "16.1.6",
    "nodemailer": "^10.0.9",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "2.0.18",
    "resend": "^6.9.3",
    "shadcn": "^4.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@cloudflare/vite-plugin": "^1.13.7",
    "@next/bundle-analyzer": "^16.1.6",
    "@oxlint/plugins": "1.82.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-rsc": "^0.5.21",
    "@vitest/coverage-v8": "^3.2.4",
    "danger": "^13.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^6.0.4",
    "lint-staged": "^16.2.6",
    "oxlint": "1.82.0",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "^19.2.4",
    "tailwindcss": "^4",
    "typedoc": "^0.28.14",
    "typescript": "^5",
    "vinext": "^0.0.31",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
