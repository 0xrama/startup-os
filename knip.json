{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies", "exports", "types"],
  "exclude": ["binaries"],
  "ignore": [".next/**", "node_modules/**", "drizzle/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["cloudflare"],
  "ignoreUnresolved": [
    "AvatarGroup",
    "AvatarGroupCount",
    "AvatarBadge",
    "DialogClose",
    "SheetClose",
    "SheetFooter",
    "getTaskStatusLabel",
    "getFirstThirtyDayChecklist",
    "Session"
  ],
  "next": {
    "entry": ["src/app/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}"],
    "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}"]
  }
}
