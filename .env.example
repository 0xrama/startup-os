# ─── Required ────────────────────────────────────────────────────

# PostgreSQL connection string. Use a pooled URL on serverless hosts
# (Neon pooler, Supabase pooler, pgbouncer, ...).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pax

# On Cloudflare Workers, a Hyperdrive binding exposes the pooled connection
# string as HYPERDRIVE_CONNECTION_STRING and takes precedence over DATABASE_URL.
# HYPERDRIVE_CONNECTION_STRING=

# Auth. Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# Public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Object storage (S3-compatible, required for the document vault) ──

R2_ENDPOINT=http://localhost:9000
# Optional public endpoint used in presigned browser URLs when the app reaches
# storage through a different container-network hostname.
# R2_PUBLIC_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_BUCKET_NAME=startup-os-local
# Set to "true" for MinIO and other path-style endpoints.
R2_FORCE_PATH_STYLE=false

# ─── AI provider (optional here — defaults can also be set in Settings) ──

# Any OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1.
AI_BASE_URL=https://api.openai.com/v1
# Optional for unauthenticated local servers (for example Ollama).
AI_API_KEY=
# Defaults to gpt-4o.
AI_MODEL=gpt-4o

# ─── Reminder scheduling (required to run cron endpoints) ────────

# Signs internal reminder requests. Vercel Cron uses CRON_SECRET automatically.
INTERNAL_CRON_SECRET=replace-me

# ─── Optional integrations ───────────────────────────────────────

# Email reminders (Resend).
RESEND_API_KEY=

# WhatsApp reminders (Meta Cloud API).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Exposes the WhatsApp channel in the onboarding wizard.
NEXT_PUBLIC_WHATSAPP_ENABLED=false

# Google OAuth (optional social sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Feature flags (optional) ────────────────────────────────────

FEATURE_ASSISTANT_RETRIEVAL=true
FEATURE_REQUEST_METRICS=true
